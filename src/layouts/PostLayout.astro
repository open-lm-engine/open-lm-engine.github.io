---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SkyControls from '../components/SkyControls.astro';
import { renderMarkdown } from '../lib/markdown';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Author {
  name: string;
  url?: string;
  affiliations?: number[];
  equalAdvising?: boolean;
}

interface ResourceLink {
  label: string;
  href: string;
  icon?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  author?: string;
  authors?: Author[];
  affiliations?: string[];
  headings: Heading[];
  codeColor?: 'pink' | 'green';
  heroImage?: ImageMetadata;
  // wide image for social-link previews; the hero image is used when absent
  banner?: ImageMetadata;
  // opts this post into the starfield background and its controls
  sky?: boolean;
  // external resources shown as pills under the byline
  links?: ResourceLink[];
  // paper-style abstract shown in the hero under the byline; Markdown with
  // $...$ math, rendered through the same remark-math + KaTeX pipeline as the body
  abstract?: string;
}

const { title, subtitle, description, author, authors, affiliations, headings, codeColor, heroImage, banner, sky = false, links, abstract } = Astro.props;
// 'green' is the site default (--code-accent already resolves to it); 'pink' points
// --code-accent at the original --accent pink instead, which is itself theme-aware.
const codeAccentStyle = codeColor === 'pink' ? '--code-accent: var(--accent);' : undefined;
const abstractHtml = abstract ? await renderMarkdown(abstract) : undefined;
// social preview: the hero image at a share-friendly size, as an absolute
// URL. JPEG rather than PNG: the 1254px RGBA hero is 2.6 MB as PNG, past what
// some unfurlers (Slack among them) will fetch; as JPEG it's a few hundred KB.
// The transparent background flattens to black, which suits the dark site.
const ogSource = banner ?? heroImage;
const ogImage = ogSource ? await getImage({ src: ogSource, width: 1200, format: 'jpg', quality: 82 }) : undefined;
const ogImageUrl = ogImage && Astro.site ? new URL(ogImage.src, Astro.site).href : undefined;
const ogCard = ogSource && ogSource.width / ogSource.height >= 1.5 ? 'summary_large_image' : 'summary';

// When a post carries a heroImage, dot the title's first lowercase "i" with it
// instead of the glyph's own dot: swap in dotless-i (U+0131, "ı") for the stem
// and place the image where the dot would be.
const iIndex = heroImage ? title.indexOf('i') : -1;
const titleBeforeI = iIndex >= 0 ? title.slice(0, iIndex) : title;
const titleAfterI = iIndex >= 0 ? title.slice(iIndex + 1) : '';
---

<BaseLayout title={`${title} | blog`} ogTitle={title} description={description} image={ogImageUrl} imageWidth={ogImage?.attributes.width} imageHeight={ogImage?.attributes.height} imageAlt={`${title} — cover image`} imageCard={ogCard} type="article" sky={sky}>
  <div class="article-shell">
    <TableOfContents headings={headings} />

    <section class="article-hero">
      <h1>
        {iIndex >= 0 ? (
          <>
            {titleBeforeI}<span class="i-star">{'ı'}<Image src={heroImage!} alt="" class="i-star-dot" width={128} height={128} /></span>{titleAfterI}
          </>
        ) : (
          title
        )}
      </h1>
      {subtitle && <p class="article-subtitle">{subtitle}</p>}
      {authors && authors.length > 0 ? (
        <p class="article-meta">
          {authors.map((a, i) => (
            <>
              {a.url ? <a href={a.url} target="_blank" rel="noopener noreferrer">{a.name}</a> : a.name}
              {((a.affiliations && a.affiliations.length > 0) || a.equalAdvising) && (
                <sup>
                  {a.affiliations && a.affiliations.length > 0 && a.affiliations.join(',')}
                  {a.equalAdvising && '*'}
                </sup>
              )}
              {i < authors.length - 1 ? ', ' : ''}
            </>
          ))}
        </p>
      ) : (
        author && <p class="article-meta">{author}</p>
      )}
      {affiliations && affiliations.length > 0 && (
        <p class="article-affiliations">
          {affiliations.map((aff, i) => (
            <>
              <sup>{i + 1}</sup>{aff}
              {i < affiliations.length - 1 ? ', ' : ''}
            </>
          ))}
        </p>
      )}
      {authors && authors.some((a) => a.equalAdvising) && (
        <p class="article-affiliations">* Equal advising</p>
      )}
      {abstractHtml && (
        <section class="article-abstract" aria-label="Abstract">
          <h2 class="article-abstract-label">Abstract</h2>
          <div class="article-abstract-body" set:html={abstractHtml} />
        </section>
      )}
      {links && links.length > 0 && (
        <nav class="article-links" aria-label="Resources">
          {links.map((l) => (
            <a class="article-link" href={l.href} {...(/^https?:/.test(l.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              {l.icon && <span class="article-link-icon" aria-hidden="true">{l.icon}</span>}
              {l.label}
            </a>
          ))}
          <p class="article-links-fallback" hidden></p>
        </nav>
      )}
      {sky && (
        <div class="hero-controls">
          <SkyControls labelled showStars />
        </div>
      )}
    </section>

    <article id="article" class="article-content" style={codeAccentStyle}>
      <slot />
    </article>
  </div>

  <script>
    // mailto: links do nothing in a browser with no registered mail handler.
    // If the window is still focused a second after a click (a mail app or
    // Gmail tab taking over would have blurred it), show the address with a
    // copy action and a Gmail compose link instead.
    (function () {
      const note = document.querySelector<HTMLElement>('.article-links-fallback');
      if (!note) return;
      let timer = 0;
      const cancel = () => window.clearTimeout(timer);
      window.addEventListener('blur', cancel);
      document.addEventListener('visibilitychange', cancel);
      document.querySelectorAll<HTMLAnchorElement>('a.article-link[href^="mailto:"]').forEach((a) => {
        a.addEventListener('click', () => {
          const url = new URL(a.href);
          const to = url.pathname;
          const subject = url.searchParams.get('subject') ?? '';
          cancel();
          timer = window.setTimeout(() => {
            if (document.visibilityState !== 'visible' || !document.hasFocus()) return;
            const gmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(to)}&su=${encodeURIComponent(subject)}`;
            note.innerHTML = '';
            note.append('No mail app opened? Write to ');
            const addr = document.createElement('code');
            addr.textContent = to;
            note.append(addr, ' · ');
            const copy = document.createElement('button');
            copy.type = 'button';
            copy.textContent = 'Copy address';
            copy.addEventListener('click', async () => {
              try {
                await navigator.clipboard.writeText(to);
                copy.textContent = 'Copied';
              } catch {
                copy.textContent = 'Select and copy above';
              }
            });
            const g = document.createElement('a');
            g.href = gmail;
            g.target = '_blank';
            g.rel = 'noopener noreferrer';
            g.textContent = 'Open in Gmail';
            note.append(copy, ' · ', g);
            note.hidden = false;
          }, 1200);
        });
      });
    })();

    // Numbers every figure in document order (standalone figures get "N";
    // figures sharing a .figure-row get "Na"/"Nb"/"Nc") and injects the
    // number into each figcaption, then resolves every <FigRef> placeholder
    // from that same computed map — one JS pass, no CSS counter round-trip,
    // so a reordered figure can never leave a stale number anywhere.
    (function () {
      const root = document.querySelector('.article-content');
      if (!root) return;

      const numbers = new Map();
      let fignum = 0;
      const handled = new Set();

      root.querySelectorAll('figure, .figure-row').forEach((node) => {
        if (handled.has(node)) return;

        const isRow = node.classList.contains('figure-row');
        const figs = isRow ? Array.from(node.querySelectorAll(':scope > figure')) : node.closest('.figure-row') ? [] : [node];
        if (isRow || figs.length) fignum++;

        figs.forEach((fig, i) => {
          handled.add(fig);
          const num = isRow ? `${fignum}${String.fromCharCode(97 + i)}` : `${fignum}`;
          if (fig.id) numbers.set(fig.id, num);
          const caption = fig.querySelector(':scope > figcaption');
          if (caption && !caption.querySelector('.fig-num')) {
            const span = document.createElement('span');
            span.className = 'fig-num';
            span.textContent = `Figure ${num}. `;
            caption.prepend(span);
          }
        });
      });

      document.querySelectorAll('a.fig-ref[data-fig-ref]').forEach((a) => {
        const targetId = a.getAttribute('data-fig-ref');
        let num = targetId ? numbers.get(targetId) : undefined;
        if (!num) return;
        if (a.hasAttribute('data-fig-ref-group')) num = num.replace(/[a-z]$/, '');
        const word = a.hasAttribute('data-fig-ref-full') ? 'Figure' : 'Fig';
        a.textContent = `${word} ${num}`;
      });
    })();
  </script>
</BaseLayout>
