---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  // social-preview (Open Graph / Twitter) fields: a title without the site
  // suffix, an absolute image URL, and the page type
  ogTitle?: string;
  image?: string;
  imageWidth?: number | string;
  imageHeight?: number | string;
  imageAlt?: string;
  imageCard?: 'summary' | 'summary_large_image';
  type?: 'website' | 'article';
  // the starfield (canvas + its controls) only ever renders on posts that opt in
  sky?: boolean;
}

const { title, description, ogTitle, image, imageWidth, imageHeight, imageAlt, imageCard = 'summary', type = 'website', sky = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// Social-preview tags are emitted as a pre-escaped string: Astro leaves a raw
// "<" inside attribute values (valid HTML), but lenient unfurlers such as
// Slack's stop reading the title at it — "…Quality with <1%…" was cut short.
const esc = (v: string | number) =>
  String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const meta = (attr: 'property' | 'name', key: string, value?: string | number) =>
  value == null || value === '' ? '' : `<meta ${attr}="${key}" content="${esc(value)}">`;
const socialTitle = ogTitle ?? title;
const socialMeta = [
  meta('property', 'og:type', type),
  meta('property', 'og:site_name', site.brand),
  meta('property', 'og:title', socialTitle),
  meta('property', 'og:description', description),
  meta('property', 'og:url', canonical),
  meta('property', 'og:image', image),
  meta('property', 'og:image:width', image ? imageWidth : undefined),
  meta('property', 'og:image:height', image ? imageHeight : undefined),
  meta('property', 'og:image:alt', image ? imageAlt : undefined),
  meta('name', 'twitter:card', image ? imageCard : 'summary'),
  meta('name', 'twitter:title', socialTitle),
  meta('name', 'twitter:description', description),
  meta('name', 'twitter:image', image),
  meta('name', 'twitter:image:alt', image ? imageAlt : undefined),
].join('\n    ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <Fragment set:html={socialMeta} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script define:vars={{ sky }}>
      (function () {
        // dark by default everywhere, unless the visitor explicitly picked light
        var stored = localStorage.getItem('theme');
        document.documentElement.setAttribute('data-theme', stored === 'light' ? 'light' : 'dark');
        if (sky) {
          // stars on by default, unless the visitor explicitly turned them off
          if (localStorage.getItem('sky') !== 'off') {
            document.documentElement.setAttribute('data-sky', 'on');
          }
          if (localStorage.getItem('sky-quality') === 'high') {
            document.documentElement.setAttribute('data-sky-quality', 'high');
          }
        }
      })();
    </script>
  </head>
  <body>
    <!-- dark-mode sky (posts with sky: true only): stars, the blue star and its
         planets, a ringed giant, comets. Drawn by src/scripts/sky.ts; the CSS
         far-star layers sit behind it. -->
    {sky && <canvas class="sky-canvas" aria-hidden="true"></canvas>}
    <a class="skip-link" href="#main">Skip to content</a>
    <Header showStars={sky} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {sky && (
      <script>
        import '../scripts/sky.ts';
      </script>
    )}
  </body>
</html>
